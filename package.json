{
  "name": "academia-acordes-gaditanos",
  "version": "0.0.0",
  "description": "Academia online de guitarra para el Carnaval de Cádiz (base Angular).",
  "scripts": {
    "ng": "ng",
    "config:init": "node scripts/ensure-local-config.mjs",
    "prestart": "npm run config:init",
    "start": "ng serve",
    "prebuild": "npm run config:init",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run config:init",
    "test": "ng test --watch=false",
    "test:sql": "node scripts/test-sql.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@supabase/supabase-js": "^2.119.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@electric-sql/pglite": "0.5.16",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
