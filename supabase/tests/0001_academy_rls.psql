-- Pruebas de permisos y RLS del modelo inicial de la academia.
--
-- Es un script de psql, no una prueba pgTAP: se ejecuta dentro de una
-- transacción y termina con ROLLBACK, así que no deja datos. Requiere un
-- PostgreSQL con la migración inicial aplicada y el esquema/auth de Supabase
-- (auth.users y auth.uid()).
--
-- Uso previsto en local, con Supabase CLI y un cliente psql:
--   supabase start
--   supabase db reset
--   psql "postgresql://postgres:postgres@localhost:54322/postgres" \
--     -v ON_ERROR_STOP=1 -f supabase/tests/0001_academy_rls.psql
--
-- No se ha ejecutado contra un proyecto Supabase remoto.

\set ON_ERROR_STOP on

begin;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

create function tests.expect(p_ok boolean, p_label text)
returns void
language plpgsql
as $$
begin
  if p_ok is not true then
    raise exception 'FALLO: %', p_label;
  end if;
  raise notice 'ok: %', p_label;
end;
$$;

create function tests.expect_permission_denied(p_sql text, p_label text)
returns void
language plpgsql
as $$
begin
  begin
    execute p_sql;
  exception
    when insufficient_privilege then
      raise notice 'ok (denegado): %', p_label;
      return;
  end;
  raise exception 'FALLO: se permitió %', p_label;
end;
$$;

create function tests.expect_sqlstate(p_sql text, p_expected text, p_label text)
returns void
language plpgsql
as $$
declare
  v_state text;
begin
  begin
    execute p_sql;
  exception
    when others then
      get stacked diagnostics v_state = returned_sqlstate;
      if v_state = p_expected then
        raise notice 'ok (restricción %): %', p_expected, p_label;
        return;
      end if;
      raise exception 'FALLO: % devolvió % y se esperaba %', p_label, v_state, p_expected;
  end;
  raise exception 'FALLO: no falló %', p_label;
end;
$$;

grant execute on function tests.expect(boolean, text) to anon, authenticated, service_role;
grant execute on function tests.expect_permission_denied(text, text) to anon, authenticated, service_role;
grant execute on function tests.expect_sqlstate(text, text, text) to anon, authenticated, service_role;

-- ---------------------------------------------------------------------------
-- Fixtures (datos ficticios, sin datos personales reales)
-- ---------------------------------------------------------------------------

