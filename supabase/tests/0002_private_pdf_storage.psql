\set ON_ERROR_STOP on
begin;

do $$
begin
  if not exists (
    select 1 from storage.buckets where id = 'lesson-pdfs'
      and public = false and file_size_limit = 10485760
      and allowed_mime_types = array['application/pdf']::text[]
  ) then raise exception 'Configuración de bucket incorrecta'; end if;
end $$;

-- Simula una política permisiva ajena para verificar la defensa restrictiva.
create policy test_broad_access on storage.objects for all to anon, authenticated
  using (true) with check (true);
insert into storage.buckets (id, name) values ('test-other-bucket', 'test-other-bucket');
insert into storage.objects (bucket_id, name)
  values ('lesson-pdfs', 'synthetic/file.pdf'), ('test-other-bucket', 'synthetic/visible.pdf');
set local role authenticated;
do $$
begin
  if not exists (select 1 from storage.objects where bucket_id = 'test-other-bucket') then
    raise exception 'Lectura de otro bucket bloqueada';
  end if;
  insert into storage.objects (bucket_id, name) values ('test-other-bucket', 'synthetic/insert.pdf');
  if not exists (select 1 from storage.objects where bucket_id = 'test-other-bucket' and name = 'synthetic/insert.pdf') then
    raise exception 'Escritura de otro bucket bloqueada';
  end if;
  if exists (select 1 from storage.objects where bucket_id = 'lesson-pdfs') then
    raise exception 'Lectura directa permitida';
  end if;
  begin
    insert into storage.objects (bucket_id, name) values ('lesson-pdfs', 'synthetic/other.pdf');
    raise exception 'Escritura directa permitida';
  exception when insufficient_privilege then null;
  end;
end $$;
reset role;
set local role anon;
do $$
begin
  if exists (select 1 from storage.objects where bucket_id = 'lesson-pdfs') then
    raise exception 'Lectura anónima permitida';
  end if;
end $$;
reset role;
rollback;
