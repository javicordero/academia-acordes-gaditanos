\set ON_ERROR_STOP on
begin;
insert into auth.users (id) values ('00000000-0000-0000-0000-00000000000a'), ('00000000-0000-0000-0000-00000000000d');
insert into public.user_roles (user_id, role) values ('00000000-0000-0000-0000-00000000000d', 'admin');
insert into public.courses (id, slug, title) values ('10000000-0000-0000-0000-000000000001', 'one', 'One');
insert into public.course_sections (id, course_id, title) values ('20000000-0000-0000-0000-000000000001', '10000000-0000-0000-0000-000000000001', 'One');
insert into public.lessons (id, course_id, section_id, slug, title) values ('30000000-0000-0000-0000-000000000001', '10000000-0000-0000-0000-000000000001', '20000000-0000-0000-0000-000000000001', 'one', 'One');
do $$
begin
 if has_function_privilege('anon', 'public.server_prepare_lesson_pdf(uuid,uuid,uuid,text,text,integer,text)', 'execute')
 or has_function_privilege('authenticated', 'public.server_prepare_lesson_pdf(uuid,uuid,uuid,text,text,integer,text)', 'execute')
 or not has_function_privilege('service_role', 'public.server_prepare_lesson_pdf(uuid,uuid,uuid,text,text,integer,text)', 'execute')
 then raise exception 'Permisos RPC incorrectos'; end if;
end $$;
select set_config('request.jwt.claims', '{"sub":"00000000-0000-0000-0000-00000000000a","user_metadata":{"role":"admin"}}', true);
set local role service_role;
do $$
declare result jsonb;
begin
 result := public.server_prepare_lesson_pdf('00000000-0000-0000-0000-00000000000a', '30000000-0000-0000-0000-000000000001', '40000000-0000-0000-0000-000000000001', 'PDF', 'file.pdf', 1, 'application/pdf');
 if result is not null then raise exception 'Alumno autorizado'; end if;
 result := public.server_prepare_lesson_pdf('00000000-0000-0000-0000-00000000000d', '30000000-0000-0000-0000-000000000002', '40000000-0000-0000-0000-000000000001', 'PDF', 'file.pdf', 1, 'application/pdf');
 if result is not null then raise exception 'Lección inexistente'; end if;
 result := public.server_prepare_lesson_pdf('00000000-0000-0000-0000-00000000000d', '30000000-0000-0000-0000-000000000001', '40000000-0000-0000-0000-000000000001', 'PDF', 'file.pdf', 1, 'application/pdf');
 if result->>'course_id' <> '10000000-0000-0000-0000-000000000001' then raise exception 'Curso incorrecto'; end if;
 if not exists (select 1 from private.lesson_resources where id = '40000000-0000-0000-0000-000000000001' and not is_downloadable and lesson_id = '30000000-0000-0000-0000-000000000001' and storage_path = '10000000-0000-0000-0000-000000000001/30000000-0000-0000-0000-000000000001/40000000-0000-0000-0000-000000000001/file.pdf') then raise exception 'Reserva incorrecta'; end if;
 begin
  perform public.server_prepare_lesson_pdf('00000000-0000-0000-0000-00000000000d', '30000000-0000-0000-0000-000000000001', '40000000-0000-0000-0000-000000000002', 'PDF', '../file.pdf', 1, 'application/pdf');
  raise exception 'Validación ausente';
 exception when raise_exception then
  if sqlerrm <> 'Invalid upload' then raise; end if;
 end;
end $$;
rollback;
