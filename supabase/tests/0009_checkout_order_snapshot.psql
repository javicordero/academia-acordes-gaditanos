select * from public.reserve_checkout_order('00000000-0000-0000-0000-000000000002','10000000-0000-0000-0000-000000000002','30000000-0000-0000-0000-000000000008',60);
do $$ begin
 if not exists(select 1 from private.checkout_attempts where attempt_id='30000000-0000-0000-0000-000000000007' and closed_at is not null and snapshot='{"fixture":true}') then raise exception 'expired history'; end if;
end $$;
insert into public.entitlements(user_id,course_id) values ('00000000-0000-0000-0000-000000000002','10000000-0000-0000-0000-000000000002');
do $$ begin
 begin perform public.reserve_checkout_order('00000000-0000-0000-0000-000000000002','10000000-0000-0000-0000-000000000002','30000000-0000-0000-0000-000000000005',60); raise exception 'expected owned'; exception when raise_exception then if sqlerrm <> 'already owned' then raise; end if; end;
 begin perform public.reserve_checkout_order('00000000-0000-0000-0000-000000000001','10000000-0000-0000-0000-000000000003','30000000-0000-0000-0000-000000000006',60); raise exception 'expected unavailable'; exception when raise_exception then if sqlerrm <> 'offer unavailable' then raise; end if; end;
end $$;
