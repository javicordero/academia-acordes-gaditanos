delete from auth.users where id='00000000-0000-0000-0000-000000000001';
do $$ begin if exists(select 1 from private.checkout_attempts where attempt_id='30000000-0000-0000-0000-000000000001' and actor_id is not null) then raise exception 'actor deletion'; end if; end $$;
